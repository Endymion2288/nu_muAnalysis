+
+WaveformFitResult&
+WaveformReconstructionTool::fitCBallOverflow(const WaveformFitResult& gfit, 
+					     const std::vector<float> time,
+					     const std::vector<float> wave) const {
+
+  ATH_MSG_DEBUG("fitCBallOverflow called");
+
+  // This must be static so we can return a reference
+  static WaveformFitResult cbfit;
+  cbfit.clear();
+
+  // Must pass arrays to TGraph, use pointer to first vector element
+  TGraph tg(time.size(), &time[0], &wave[0]);
+
+  // Find overflow times
+  // Must look for removed elements
+  float tover_start = time.front();
+  float tover_end = time.back();
+
+  for (unsigned int i=1; i<wave.size(); i++) {
+    if (time[i]-time[i-1] <= 2.1) continue; // 2ns is normal spacing
+    tover_start = time[i-1];
+    tover_end = time[i];
+    break;
+  }
+  
+  if (tover_start == time.front()) {
+    ATH_MSG_INFO("fitCBOverflow called but no overflow found!"); 
+  }
+
+  auto peakloc = std::max_element(wave.begin(), wave.end());
+  float maxval = *peakloc;
+  
+  // Values to preset CB fit
+  cbfit.peak = std::max(abs(gfit.peak), 1.1*maxval);
+  cbfit.mean = (2*tover_start + tover_end)/3.;  // 1/3 of the way through
+  cbfit.sigma = 4.;
+  cbfit.alpha = -2.;  // Negative to get tail on high side
+  cbfit.nval = 2.;
+
+  //
+  // Will try a series of fits, only update cbfit if a fit succeeds
+  //
+  
+  // Lets try fixing the mean first and fit the tail parameters
+  
+  // Define fit function and preset values
+  // Only fit to + m_overflowFitRange (170 ns) to avoid undershoot at end
+  TF1 cbfunc("cbfunc", "crystalball", time.front(), std::min(time.front()+m_overflowFitRange, time.back()));
+  cbfunc.SetParameter(0, cbfit.peak); // Peak height
+  cbfunc.SetParError(0, cbfit.peak/10.);
+  cbfunc.SetParLimits(0, maxval, 1.E6); 
+  cbfunc.FixParameter(1, cbfit.mean);
+  cbfunc.FixParameter(2, cbfit.sigma);
+  
+  // Fit the tail parameters
+  cbfunc.SetParameter(3, cbfit.alpha); // Tail parameter (negative for high-side tail)
+  cbfunc.SetParError(3, -cbfit.alpha/5.);
+  cbfunc.SetParLimits(3, -10., 0.);
+  cbfunc.SetParameter(4, cbfit.nval);  // Tail power
+  cbfunc.SetParError(4, cbfit.nval/5.);
+  cbfunc.SetParLimits(4, 0., 1.E3);
+
+  TFitResultPtr cbfitptr = tg.Fit(&cbfunc, "QNSB", "");
+
+  // Always take result of first fit
+  cbfit.fit_status = cbfitptr;
+  cbfit.valid = (cbfit.fit_status%10 == 0);
+
+  cbfit.peak = cbfitptr->Parameter(0);
+  cbfit.mean = cbfitptr->Parameter(1);
+  cbfit.sigma = cbfitptr->Parameter(2);
+  cbfit.alpha = cbfitptr->Parameter(3);
+  cbfit.nval = cbfitptr->Parameter(4);
+
+  double chi2 = cbfitptr->Chi2();
+  unsigned int ndf = std::max(cbfitptr->Ndf(), static_cast<unsigned int>(1));
+  cbfit.chi2ndf = chi2/ndf;
+  
+  if (cbfitptr%10) {
+    // Bad fit
+    ATH_MSG_DEBUG( " First Crystal Ball waveform fit failed! ");
+    ATH_MSG_DEBUG( " Gauss Mean: " << gfit.mean << " RMS: " << gfit.sigma << " Peak:" << gfit.peak);
+    ATH_MSG_DEBUG( " CB    Mean: " << cbfitptr->Parameter(1) << " RMS: " << cbfitptr->Parameter(2) << " Peak:" << cbfitptr->Parameter(0) << " Alpha: " << cbfitptr->Parameter(3));
+  } else {
+    // Good fit
+    ATH_MSG_DEBUG( " First Crystal Ball waveform fit ");
+    ATH_MSG_DEBUG( " Gauss Mean: " << gfit.mean << " RMS: " << gfit.sigma << " Peak:" << gfit.peak);
+    ATH_MSG_DEBUG( " CB    Mean: " << cbfitptr->Parameter(1) << " RMS: " << cbfitptr->Parameter(2) << " Peak:" << cbfitptr->Parameter(0) << " Alpha: " << cbfitptr->Parameter(3));
+  }
+
+  // Now lets just release the mean and fix the rest
+  cbfunc.ReleaseParameter(1);
+  cbfunc.SetParameter(1, cbfit.mean);
+  cbfunc.SetParError(1, cbfit.sigma);
+  cbfunc.SetParLimits(1, tover_start, (tover_start+tover_end)/2.);
+  cbfunc.FixParameter(2, cbfit.sigma);  
+  cbfunc.FixParameter(3, cbfit.alpha);
+  cbfunc.FixParameter(4, cbfit.nval);
+
+  cbfitptr = tg.Fit(&cbfunc, "QNSB", "");
+
+  // Only update if fit succeeded
+  
+  if (cbfitptr%10) {
+    ATH_MSG_DEBUG( " Second Crystal Ball waveform fit failed! ");
+    ATH_MSG_DEBUG( " Gauss Mean: " << gfit.mean << " RMS: " << gfit.sigma << " Peak:" << gfit.peak);
+    ATH_MSG_DEBUG( " CB    Mean: " << cbfitptr->Parameter(1) << " RMS: " << cbfitptr->Parameter(2) << " Peak:" << cbfitptr->Parameter(0) << " Alpha: " << cbfitptr->Parameter(3));
+  } else {
+    ATH_MSG_DEBUG( " Second Crystal Ball waveform fit ");
+    ATH_MSG_DEBUG( " Gauss Mean: " << gfit.mean << " RMS: " << gfit.sigma << " Peak:" << gfit.peak);
+    ATH_MSG_DEBUG( " CB    Mean: " << cbfitptr->Parameter(1) << " RMS: " << cbfitptr->Parameter(2) << " Peak:" << cbfitptr->Parameter(0) << " Alpha: " << cbfitptr->Parameter(3));
+
+    // Update parameters
+    cbfit.fit_status = cbfitptr;
+    cbfit.valid = (cbfit.fit_status%10 == 0);
+
+    cbfit.peak = cbfitptr->Parameter(0);
+    cbfit.mean = cbfitptr->Parameter(1);
+    cbfit.sigma = cbfitptr->Parameter(2);
+    cbfit.alpha = cbfitptr->Parameter(3);
+    cbfit.nval = cbfitptr->Parameter(4);
+
+    chi2 = cbfitptr->Chi2();
+    ndf = std::max(cbfitptr->Ndf(), static_cast<unsigned int>(1));
+    cbfit.chi2ndf = chi2/ndf;
+  }
+
+  // Now relax all limits
+  cbfunc.ReleaseParameter(2);
+  cbfunc.SetParLimits(2, 2., 10.);
+  cbfunc.SetParError(2, cbfit.sigma/5.);
+  cbfunc.ReleaseParameter(3);
+  cbfunc.ReleaseParameter(4);
+  
+  cbfitptr = tg.Fit(&cbfunc, "QNSB", "");
+
+  // Only update if fit succeeded
+  if (cbfitptr%10) {
+    ATH_MSG_DEBUG( " Full Crystal Ball waveform fit failed! ");
+    ATH_MSG_DEBUG( " Gauss Mean: " << gfit.mean << " RMS: " << gfit.sigma << " Peak:" << gfit.peak);
+    ATH_MSG_DEBUG( " CB    Mean: " << cbfitptr->Parameter(1) << " RMS: " << cbfitptr->Parameter(2) << " Peak:" << cbfitptr->Parameter(0) << " Alpha: " << cbfitptr->Parameter(3));
+  } else {
+    ATH_MSG_DEBUG( " Full Crystal Ball waveform fit ");
+    ATH_MSG_DEBUG( " CB    Mean: " << cbfitptr->Parameter(1) << " RMS: " << cbfitptr->Parameter(2) << " Peak:" << cbfitptr->Parameter(0) << " Alpha: " << cbfitptr->Parameter(3));
+
+    cbfit.fit_status = cbfitptr;
+    cbfit.valid = (cbfit.fit_status%10 == 0);
+
+    cbfit.peak = cbfitptr->Parameter(0);
+    cbfit.mean = cbfitptr->Parameter(1);
+    cbfit.sigma = cbfitptr->Parameter(2);
+    cbfit.alpha = cbfitptr->Parameter(3);
+    cbfit.nval = cbfitptr->Parameter(4);
+    
+    chi2 = cbfitptr->Chi2();
+    ndf = std::max(cbfitptr->Ndf(), static_cast<unsigned int>(1));
+    cbfit.chi2ndf = chi2/ndf;
+  }
+
+  // If we have a good fit, extract integral and time
+  if (cbfit.valid) {
+    
+    // Try specific integral function to avoid FPE from symbolic integrator failing?
+    // Start with default precision values, yes this works!
+    double error;
+    cbfit.integral = cbfunc.IntegralOneDim(time.front(), time.back(), -1, -1, error);
+
+    // Find time here (start from t=0 to avoid NaN)
+    cbfit.time = cbfunc.GetX( cbfit.peak * m_timingPeakFraction, 0., cbfit.mean );
+
+    if (isnan(cbfit.time)) {
+      ATH_MSG_WARNING(" Crystal Ball fit returned time as NaN, assume fit failes");
+      cbfit = gfit;
+      cbfit.time = tover_start;
+      cbfit.fit_status = 4;
+      cbfit.valid = false;
+    }
+  } else {
+    // Fit failed, use overflow start for time
+    // I think this gets overwritten anyways
+    cbfit.time = tover_start;
+  }
+  
+  ATH_MSG_DEBUG("CB Fit  Mean: " << cbfit.mean << " RMS: " << cbfit.sigma 
+	       << " Peak: " << cbfit.peak << " Int: " << cbfit.integral
+	       << " Time: " << cbfit.time 
+	       << " N: " << cbfit.nval << " Alpha: " << cbfit.alpha 
+	       << " Chi2/Ndf: " << cbfit.chi2ndf );
+
+  return cbfit;
+}
