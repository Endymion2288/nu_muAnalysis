+#!/usr/bin/env bash
+# Usage: bash ./build_local.sh [parallel jobs, default 8]
+set -o pipefail
+georotation_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || exit
+source "$georotation_root/setup_environment.sh" --build || exit
+set -e
+cmake -S "$georotation_root" -B "$georotation_root/build" \
+    -DCMAKE_INSTALL_PREFIX="$georotation_root/run" \
+    -DATLAS_PACKAGE_FILTER_FILE="$georotation_root/package_filters.txt"
+cmake --build "$georotation_root/build" --parallel "${1:-8}"
+cmake --install "$georotation_root/build"
