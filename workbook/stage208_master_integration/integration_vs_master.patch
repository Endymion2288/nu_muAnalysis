new file mode 100755
index 00000000..286d6d6f
--- /dev/null
+++ b/setup_environment.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# Usage: source ./setup_environment.sh [--build]
+if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
+    echo 'Use: source ./setup_environment.sh [--build]' >&2
+    exit 1
+fi
+_georotation_environment() {
+    local georotation_root georotation_cwd="$PWD" georotation_status
+    georotation_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || return
+    export ATLAS_LOCAL_ROOT_BASE=/cvmfs/atlas.cern.ch/repo/ATLASLocalRootBase
+    source "${ATLAS_LOCAL_ROOT_BASE}/user/atlasLocalSetup.sh" --quiet || return
+    cd "$georotation_root" || return
+    source "${AtlasSetup}/scripts/asetup.sh" --input="$georotation_root/asetup.faser" Athena,24.0.41
+    georotation_status=$?
+    cd "$georotation_cwd" || return
+    [[ $georotation_status -eq 0 ]] || return "$georotation_status"
+    if [[ "${1:-}" != --build ]]; then
+        [[ -f "$georotation_root/run/setup.sh" ]] || {
+            echo 'Build first with: bash ./build_local.sh' >&2
+            return 1
+        }
+        source "$georotation_root/run/setup.sh" || return
+    fi
+}
+_georotation_environment "$@"
+_georotation_status=$?
+unset -f _georotation_environment
+return "$_georotation_status"
