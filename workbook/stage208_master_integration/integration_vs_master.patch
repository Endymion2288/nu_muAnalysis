new file mode 100755
index 00000000..35625a3f
--- /dev/null
+++ b/verify_local.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -o pipefail
+georotation_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || exit
+source "$georotation_root/setup_environment.sh" || exit
+set -e
+export GEOROTATION_VERIFY_ROOT="$georotation_root"
+python3 - <<'PY'
+import ctypes
+import os
+from pathlib import Path
+from AthenaConfiguration.ComponentFactory import CompFactory
+
+root = Path(os.environ['GEOROTATION_VERIFY_ROOT'])
+for name in ('GeoModelFaserUtilities', 'FaserActsGeometry', 'FaserActsKalmanFilter', 'NtupleDumper'):
+    path = root / 'run' / 'lib' / ('lib' + name + '.so')
+    assert path.is_file(), path
+    ctypes.CDLL(str(path), mode=os.RTLD_GLOBAL)
+    print('Loaded:', path)
+for name in ('FaserActsTrackingGeometrySvc', 'FaserActsTrackingGeometryTool', 'CKF2', 'KalmanFitterTool', 'NtupleDumperAlg'):
+    instance = CompFactory.getComp(name)('BuildVerification')
+    print('Configured:', instance.getType())
+print('Athena:', os.environ.get('AtlasVersion'))
+print('Calypso:', os.environ.get('Calypso_DIR'))
+PY
+ctest --test-dir "$georotation_root/build" \
+    -R 'GeoModelFaserUtilities_Geo(GetIds|VisitVolumes)_test|FaserActsKalmanFilter_CandidateIsolatedSmoothing'  --no-tests=error --output-on-failure
