--- /dev/null
+++ b/Tracking/Acts/FaserActsGeometry/python/RotatedMaterialMap.py
@@ -0,0 +1,23 @@
+# Copyright (C) 2026 CERN for the benefit of the FASER collaboration
+"""Locate the validated material map for the rotated ACTS global frame."""
+from functools import lru_cache
+import gzip
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+_materialDirectories = []
+
+
+@lru_cache(maxsize=1)
+def rotatedMaterialMapPath():
+    """Expand the packaged map once and keep it alive for this process."""
+    from PathResolver import PathResolver
+    source = PathResolver.FindCalibFile(
+        "FaserActsGeometry/material-maps-alma9-rotated-rowmajor.json.gz")
+    if not source:
+        raise FileNotFoundError("Packaged rotated ACTS material map was not installed")
+    directory = TemporaryDirectory(prefix="faser_rotated_material_")
+    _materialDirectories.append(directory)
+    target = Path(directory.name) / "material-maps-alma9-rotated-rowmajor.json"
+    target.write_bytes(gzip.decompress(Path(source).read_bytes()))
+    return str(target)
