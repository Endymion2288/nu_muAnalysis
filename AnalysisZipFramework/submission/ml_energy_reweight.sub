universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage73
initialdir = $(spool)
executable = /bin/bash
transfer_executable = False
arguments = $(spool)/worker_v1.sh $(job)
