universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
initialdir = $(repository)
executable = $(repository)/AnalysisZipFramework/submission/run_ml_muon_oracle.sh
arguments = $(seed_index) energy-ml-oracle-stage15.tar.gz $(repository)/workbook/stage15_energy_ml $(repository)/ml/artifacts/stage15
