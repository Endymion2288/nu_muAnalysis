universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
initialdir = $(repository)
executable = $(repository)/AnalysisZipFramework/submission/run_ml_set_extract.sh
arguments = $(Process) energy-ml-set-extract-stage19.tar.gz $(repository)/ntuples/energy_ml_stage19/shards/$(Process).npz
