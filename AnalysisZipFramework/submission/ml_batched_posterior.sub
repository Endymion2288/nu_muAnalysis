universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage91
initialdir = $(spool)
executable = /bin/bash
transfer_executable = False
arguments = $(spool)/worker_v1.sh
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-batched-stage91.tar.gz
should_transfer_files = YES
transfer_output_files = ""
request_cpus = 2
request_memory = 6000MB
request_gpus = 1
require_gpus = GlobalMemoryMb >= 8192 && regexp("T4|A100|H100|H200|L4", DeviceName)
request_disk = 300MB
max_retries = 0
+MaxRuntime = 1800
+NuMuStage = "energy-ml-batched-stage91"
log = $(spool)/logs/$(ClusterId).$(ProcId).log
output = $(spool)/logs/$(ClusterId).$(ProcId).out
error = $(spool)/logs/$(ClusterId).$(ProcId).err
queue 1
