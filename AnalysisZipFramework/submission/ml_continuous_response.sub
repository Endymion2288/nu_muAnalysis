universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage62
initialdir = $(spool)
executable = $(spool)/run_ml_continuous_response.sh
arguments = $(model)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-continuous-stage62.tar.gz
should_transfer_files = YES
transfer_output_files = ""
request_cpus = 1
request_memory = 3000MB
request_disk = 300MB
getenv = False
max_retries = 0
+JobFlavour = "microcentury"
+MaxRuntime = 3300
+NuMuStage = "energy-ml-continuous-stage62"
log = $(spool)/logs/continuous.$(ClusterId).log
output = $(spool)/logs/continuous.$(ClusterId).$(ProcId).out
error = $(spool)/logs/continuous.$(ClusterId).$(ProcId).err
queue model in A_full_unit,B_full_flat,C_mu_unit
