universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
initialdir = $(repository)
executable = $(repository)/AnalysisZipFramework/submission/run_tracking_comparison.sh
payload = $(repository)/software/tracking-z-stage10.tar.gz
arguments = $(index) $(rdo) $(geometry) $(merge) $(report) $(repository) $(payload) -1 fiducial
request_cpus = 1
request_memory = 3000MB
request_disk = 6000MB
environment = "OMP_NUM_THREADS=1"
should_transfer_files = YES
# Data products are uploaded explicitly; only configured stdout/stderr are returned.
transfer_output_files = ""
getenv = False
+JobFlavour = "workday"
+NuMuRun = $(run)
+NuMuCalypsoCommit = "d32b0ff3cc4a2dad4abfb1474a82422c3c25b305"
log = $(repository)/logs/tracking_z_$(ClusterId).log
output = $(repository)/logs/tracking_z_$(ClusterId).$(ProcId).out
error = $(repository)/logs/tracking_z_$(ClusterId).$(ProcId).err
requirements = (Machine =!= "b9p02p8722.cern.ch")
queue index,run,geometry,rdo,merge,report from AnalysisZipFramework/submission/tracking_z_manifest.tsv
