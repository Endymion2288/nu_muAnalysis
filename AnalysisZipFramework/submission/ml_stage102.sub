universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage102
stage102_mode = qa
stage102_cpus = 2
stage102_memory = 6000MB
stage102_gpus = 1
initialdir = $(spool)
executable = /bin/bash
transfer_executable = False
arguments = $(spool)/worker.sh $(stage102_mode)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-stage102-$(stage102_mode).tar.gz
should_transfer_files = YES
transfer_output_files = ""
request_cpus = $(stage102_cpus)
request_memory = $(stage102_memory)
request_gpus = $(stage102_gpus)
require_gpus = GlobalMemoryMb >= 8192 && regexp("T4|A100|H100|H200|L4", DeviceName)
request_disk = 1024MB
max_retries = 0
+MaxRuntime = 600
+NuMuStage = "energy-ml-stage102"
log = $(spool)/logs/$(ClusterId).$(ProcId).log
output = $(spool)/logs/$(ClusterId).$(ProcId).out
error = $(spool)/logs/$(ClusterId).$(ProcId).err
queue 1
