universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
initialdir = $(repository)
executable = $(repository)/AnalysisZipFramework/submission/run_ml_spatial_train.sh
arguments = $(Process) energy-ml-spatial-train-stage18.tar.gz $(repository)
transfer_input_files = $(repository)/software/energy-ml-spatial-train-stage18.tar.gz
request_cpus = 1
request_gpus = 1
gpus_minimum_capability = 7.5
gpus_minimum_memory = 8GB
