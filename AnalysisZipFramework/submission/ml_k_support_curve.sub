universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage82_curve
initialdir = $(spool)
executable = /bin/bash
transfer_executable = False
arguments = $(spool)/worker_v1.sh $(arm)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-k-curve-stage82.tar.gz
should_transfer_files = YES
transfer_output_files = ""
request_cpus = 1
request_memory = 3000MB
request_disk = 180MB
max_retries = 0
+JobFlavour = "espresso"
+MaxRuntime = 1800
+NuMuStage = "energy-ml-k-curve-stage82"
log = $(spool)/logs/curve.$(ClusterId).log
output = $(spool)/logs/curve.$(ClusterId).$(ProcId).out
error = $(spool)/logs/curve.$(ClusterId).$(ProcId).err
queue arm in half full
