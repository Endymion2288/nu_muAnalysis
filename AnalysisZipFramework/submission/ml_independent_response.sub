universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage27
initialdir = $(spool)
executable = $(spool)/run_ml_independent_response.sh
arguments = $(model) $(seed) $(alpha_index) energy-ml-independent-stage27.tar.gz $(repository)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-independent-stage27.tar.gz
request_cpus = 1
request_memory = 3000MB
request_disk = 200MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "microcentury"
+NuMuStage = "energy-ml-independent-response"
log = $(spool)/logs/ml_independent_$(ClusterId).log
output = $(spool)/logs/ml_independent_$(ClusterId).$(ProcId).out
error = $(spool)/logs/ml_independent_$(ClusterId).$(ProcId).err
queue model, seed, alpha_index from (
mu_p_over0p8 0 0
mu_p_over0p8 0 1
mu_p_over0p8 0 2
bdt_UU 0 0
bdt_UU 0 1
bdt_UU 0 2
bdt_UU 1 0
bdt_UU 1 1
bdt_UU 1 2
bdt_UU 2 0
bdt_UU 2 1
bdt_UU 2 2
tabm_UU 0 0
tabm_UU 0 1
tabm_UU 0 2
tabm_UU 1 0
tabm_UU 1 1
tabm_UU 1 2
tabm_UU 2 0
tabm_UU 2 1
tabm_UU 2 2
)
