universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage33
initialdir = $(spool)
executable = $(spool)/run_ml_reference_audit.sh
arguments = $(action) $(index) energy-ml-reference-audit-stage33.tar.gz $(repository) 33
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-reference-audit-stage33.tar.gz
request_cpus = 1
request_memory = 3000MB
request_disk = 2000MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "microcentury"
+NuMuStage = "energy-ml-low-momentum-audit"
log = $(spool)/logs/native_$(ClusterId).log
output = $(spool)/logs/native_$(ClusterId).$(ProcId).out
error = $(spool)/logs/native_$(ClusterId).$(ProcId).err
queue action,index from (
truth 178
cov 178
)
