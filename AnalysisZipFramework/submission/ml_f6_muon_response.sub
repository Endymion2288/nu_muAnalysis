universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage52
initialdir = $(spool)
executable = /bin/bash
transfer_executable = False
arguments = $(spool)/run_ml_f6_muon_response.sh $(Process) energy-ml-f6-muon-response-stage52.tar.gz $(repository)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-f6-muon-response-stage52.tar.gz
request_cpus = 1
request_memory = 1500MB
request_disk = 200MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "microcentury"
+NuMuStage = "energy-ml-f6-muon-response-stage52"
log = $(spool)/logs/$(ClusterId).log
output = $(spool)/logs/$(ClusterId).$(ProcId).out
error = $(spool)/logs/$(ClusterId).$(ProcId).err
queue 6
