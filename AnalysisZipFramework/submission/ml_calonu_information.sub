universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage42
initialdir = $(spool)
executable = $(spool)/run_ml_calonu_information.sh
arguments = $(mode) $(index) energy-ml-calonu-information-stage42.tar.gz $(repository)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-calonu-information-stage42.tar.gz
request_cpus = 1
request_memory = 4000MB
request_disk = 1000MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "microcentury"
+NuMuStage = "energy-ml-calonu-information-stage42"
log = $(spool)/logs/$(ClusterId).log
output = $(spool)/logs/$(ClusterId).$(ProcId).out
error = $(spool)/logs/$(ClusterId).$(ProcId).err
queue mode,index from $(jobs)
