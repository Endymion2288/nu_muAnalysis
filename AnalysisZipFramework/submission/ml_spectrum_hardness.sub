universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage65
initialdir = $(spool)
executable = $(spool)/run_ml_spectrum_hardness.sh
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-hardness-stage65.tar.gz
should_transfer_files = YES
transfer_output_files = ""
request_cpus = 1
request_memory = 3000MB
request_disk = 100MB
getenv = False
max_retries = 0
+JobFlavour = "microcentury"
+MaxRuntime = 600
+NuMuStage = "energy-ml-spectrum-hardness-stage65"
log = $(spool)/logs/hardness.$(ClusterId).log
output = $(spool)/logs/hardness.$(ClusterId).$(ProcId).out
error = $(spool)/logs/hardness.$(ClusterId).$(ProcId).err
queue 1
