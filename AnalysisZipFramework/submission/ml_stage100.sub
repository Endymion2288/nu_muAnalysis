universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage100
stage100_mode = qa
initialdir = $(spool)
executable = /bin/bash
transfer_executable = False
arguments = $(spool)/worker.sh $(stage100_mode)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-stage100-$(stage100_mode).tar.gz
should_transfer_files = YES
transfer_output_files = ""
request_cpus = 2
request_memory = 6000MB
request_disk = 1024MB
max_retries = 0
