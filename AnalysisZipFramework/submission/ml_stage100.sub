+NuMuStage = "energy-ml-stage100"
log = $(spool)/logs/$(ClusterId).$(ProcId).log
output = $(spool)/logs/$(ClusterId).$(ProcId).out
error = $(spool)/logs/$(ClusterId).$(ProcId).err
queue 1
