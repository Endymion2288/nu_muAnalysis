universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage35
initialdir = $(spool)
executable = $(spool)/run_ml_calonu.sh
arguments = $(action) $(Process) energy-ml-calonu-stage35-$(action).tar.gz $(repository)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-calonu-stage35-$(action).tar.gz
request_cpus = $(cpus)
request_memory = 2000MB
request_disk = 500MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "espresso"
+NuMuStage = "energy-ml-calonu-stage35"
log = $(spool)/logs/$(action)_$(ClusterId).log
output = $(spool)/logs/$(action)_$(ClusterId).$(ProcId).out
error = $(spool)/logs/$(action)_$(ClusterId).$(ProcId).err
