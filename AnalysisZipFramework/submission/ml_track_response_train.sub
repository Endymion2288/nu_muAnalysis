universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage31
initialdir = $(spool)
executable = $(spool)/run_ml_track_response.sh
arguments = train $(index) energy-ml-track-response-stage31.tar.gz $(repository)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-track-response-stage31.tar.gz
request_cpus = 4
request_memory = 3000MB
request_disk = 250MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "microcentury"
+NuMuStage = "energy-ml-track-response-train"
log = $(spool)/logs/train_$(ClusterId).log
output = $(spool)/logs/train_$(ClusterId).$(ProcId).out
error = $(spool)/logs/train_$(ClusterId).$(ProcId).err
queue index in 0,1,2
