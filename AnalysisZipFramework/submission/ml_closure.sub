universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage23
initialdir = $(spool)
executable = $(spool)/run_ml_closure.sh
arguments = $(model) energy-ml-closure-stage23.tar.gz $(repository)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-closure-stage23.tar.gz
request_cpus = 1
request_memory = 3000MB
request_disk = 200MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "espresso"
+NuMuStage = "energy-ml-closure"
log = $(spool)/logs/ml_closure_$(ClusterId).log
output = $(spool)/logs/ml_closure_$(ClusterId).$(ProcId).out
error = $(spool)/logs/ml_closure_$(ClusterId).$(ProcId).err
queue model in mu_p,mu_p_over0p8,bdt_UU,bdt_FU,tabm_UU,tabm_FU
