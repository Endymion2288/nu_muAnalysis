universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage53
initialdir = $(spool)
executable = /bin/bash
transfer_executable = False
arguments = $(spool)/run_ml_tracker_noise.sh $(Process) $(mode) $(repository)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-tracker-noise-stage53.tar.gz,root://eoshome-x.cern.ch/$(repository)/software/calypso-master-d32b0ff3-el9-gcc13.tar.gz
request_cpus = 1
request_memory = 4GB
request_disk = 1GB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "microcentury"
+NuMuStage = "energy-ml-tracker-noise-stage53-$(mode)"
log = $(spool)/logs/$(mode).$(ClusterId).log
output = $(spool)/logs/$(mode).$(ClusterId).$(ProcId).out
error = $(spool)/logs/$(mode).$(ClusterId).$(ProcId).err
queue 6
