universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
initialdir = $(repository)
executable = $(repository)/AnalysisZipFramework/submission/run_tracking_loss.sh
payload = $(repository)/software/tracking-loss-stage17.tar.gz
arguments = $(run) $(event) $(rdo) $(merge) $(report) $(payload) $(fbits) $(bbits) $(mbits)
