output = $(repository)/logs/tracking_loss_$(ClusterId).$(ProcId).out
error = $(repository)/logs/tracking_loss_$(ClusterId).$(ProcId).err
requirements = (Machine =!= "b9p02p8722.cern.ch")
queue run,event,rdo,merge,report,fbits,bbits,mbits from AnalysisZipFramework/submission/tracking_loss_manifest.tsv
