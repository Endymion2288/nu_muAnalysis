universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage22
initialdir = $(spool)
executable = $(spool)/run_ml_prior.sh
arguments = bdt $(mode) energy-ml-prior-cpu-threaded-stage22.tar.gz $(repository) ml/configs/prior_budget_cpu.yaml 22
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-prior-cpu-threaded-stage22.tar.gz
request_cpus = 4
request_memory = 3000MB
request_disk = 500MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "espresso"
+NuMuStage = "energy-ml-prior-budget"
log = $(spool)/logs/ml_prior_budget_cpu_$(ClusterId).log
output = $(spool)/logs/ml_prior_budget_cpu_$(ClusterId).$(ProcId).out
error = $(spool)/logs/ml_prior_budget_cpu_$(ClusterId).$(ProcId).err
queue mode in UU,FU
