universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage30
initialdir = $(spool)
executable = $(spool)/run_ml_information_gap.sh
arguments = $(seed) $(mode) energy-ml-information-gap-stage30.tar.gz $(repository)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-information-gap-stage30.tar.gz
request_cpus = 4
request_memory = 3000MB
request_disk = 200MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "microcentury"
+NuMuStage = "energy-ml-information-gap"
log = $(spool)/logs/ml_information_gap_$(ClusterId).log
output = $(spool)/logs/ml_information_gap_$(ClusterId).$(ProcId).out
error = $(spool)/logs/ml_information_gap_$(ClusterId).$(ProcId).err
mode = main
queue seed in 0,1,2
