universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/condor/nu_muAnalysis/stage108
# Use: condor_submit -append 'stage108_mode = report' <this file>
stage108_mode = required
initialdir = $(spool)
executable = /bin/bash
transfer_executable = False
arguments = $(spool)/worker.sh $(stage108_mode)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-stage108-$(stage108_mode).tar.gz
should_transfer_files = YES
transfer_output_files = ""
request_cpus = 8
request_memory = 8000MB
request_disk = 4096MB
max_retries = 0
+MaxRuntime = 3600
+NuMuStage = "energy-ml-stage108"
log = $(spool)/logs/$(ClusterId).$(ProcId).log
output = $(spool)/logs/$(ClusterId).$(ProcId).out
error = $(spool)/logs/$(ClusterId).$(ProcId).err
queue 1
