universe = vanilla
repository = /eos/user/x/xcheng/FASER/nu_muAnalysis
spool = /afs/cern.ch/user/x/xcheng/nu_mu_stage48
initialdir = $(spool)
executable = $(spool)/run_ml_source_transfer.sh
transfer_executable = False
arguments = $(mode) $(batch) energy-ml-source-transfer-stage48-$(mode).tar.gz $(repository)
transfer_input_files = root://eoshome-x.cern.ch/$(repository)/software/energy-ml-source-transfer-stage48-$(mode).tar.gz
request_cpus = 1
request_memory = 1000MB
request_disk = 200MB
should_transfer_files = YES
transfer_output_files = ""
getenv = False
+JobFlavour = "espresso"
+NuMuStage = "energy-ml-source-transfer-stage48"
log = $(spool)/logs/$(ClusterId).log
output = $(spool)/logs/$(ClusterId).$(ProcId).out
error = $(spool)/logs/$(ClusterId).$(ProcId).err
queue mode,batch from $(jobs)
